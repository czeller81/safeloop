{
  "id": "coding",
  "name": "Coding agent",
  "description": "Reference profile for an autonomous coding agent working inside a declared workspace. Reads and in-workspace writes flow; commits, pushes, and anything leaving the workspace are held for a human; history rewriting and credential access are refused.",
  "default_disposition": "ALLOW",
  "memory_write_policy": "allow_with_ttl",
  "minimum_memory_confidence": 0.7,
  "budgets": {
    "maximum_actions": 500,
    "maximum_runtime_ms": 3600000,
    "maximum_tokens": 2000000,
    "maximum_cost_usd": 25,
    "maximum_retries": 10
  },
  "rules": [
    {
      "id": "fs.read.workspace",
      "description": "Reading inside the workspace is ordinary work.",
      "disposition": "ALLOW",
      "match": {
        "action_kinds": [
          "filesystem"
        ],
        "operations": [
          "read",
          "list",
          "stat"
        ],
        "workspace": "inside"
      }
    },
    {
      "id": "fs.read.outside",
      "description": "Reading outside the workspace is allowed but recorded.",
      "disposition": "ALLOW_WITH_WARNING",
      "match": {
        "action_kinds": [
          "filesystem"
        ],
        "operations": [
          "read",
          "list",
          "stat"
        ],
        "workspace": "outside"
      }
    },
    {
      "id": "fs.write.workspace",
      "description": "Creating and writing files inside the workspace is ordinary work.",
      "disposition": "ALLOW",
      "match": {
        "action_kinds": [
          "filesystem"
        ],
        "operations": [
          "create",
          "write",
          "append",
          "mkdir"
        ],
        "workspace": "inside"
      }
    },
    {
      "id": "fs.write.outside",
      "description": "Writing outside the declared workspace requires a human decision.",
      "disposition": "REQUIRE_APPROVAL",
      "match": {
        "action_kinds": [
          "filesystem"
        ],
        "operations": [
          "create",
          "write",
          "append",
          "mkdir"
        ],
        "workspace": "outside"
      }
    },
    {
      "id": "fs.write.unknown",
      "description": "A write whose workspace relation cannot be determined is treated as outside.",
      "disposition": "REQUIRE_APPROVAL",
      "match": {
        "action_kinds": [
          "filesystem"
        ],
        "operations": [
          "create",
          "write",
          "append",
          "mkdir"
        ],
        "workspace": "unknown"
      }
    },
    {
      "id": "fs.destructive.workspace",
      "description": "Deleting or overwriting inside the workspace is allowed but flagged.",
      "disposition": "ALLOW_WITH_WARNING",
      "match": {
        "action_kinds": [
          "filesystem"
        ],
        "destructive": true,
        "workspace": "inside"
      }
    },
    {
      "id": "fs.destructive.outside",
      "description": "Destructive filesystem operations outside the workspace are refused.",
      "disposition": "DENY",
      "match": {
        "action_kinds": [
          "filesystem"
        ],
        "destructive": true,
        "workspace": "outside"
      }
    },
    {
      "id": "fs.destructive.unknown",
      "description": "A destructive operation with an undeterminable workspace relation is refused.",
      "disposition": "DENY",
      "match": {
        "action_kinds": [
          "filesystem"
        ],
        "destructive": true,
        "workspace": "unknown"
      }
    },
    {
      "id": "path.sensitive",
      "description": "Credential, key, and secret paths are refused regardless of workspace.",
      "disposition": "DENY",
      "match": {
        "sensitive_path": true
      }
    },
    {
      "id": "path.governance-config",
      "description": "An agent may not modify the configuration that governs it.",
      "disposition": "DENY",
      "match": {
        "action_kinds": [
          "filesystem"
        ],
        "governance_config": true,
        "operations": [
          "create",
          "write",
          "append",
          "overwrite",
          "delete",
          "move",
          "chmod"
        ]
      }
    },
    {
      "id": "git.read",
      "description": "Git inspection is ordinary work.",
      "disposition": "ALLOW",
      "match": {
        "action_kinds": [
          "git"
        ],
        "operations": [
          "status",
          "diff",
          "log",
          "show",
          "branch_list",
          "remote_list"
        ]
      }
    },
    {
      "id": "git.add",
      "description": "Staging changes is ordinary work.",
      "disposition": "ALLOW",
      "match": {
        "action_kinds": [
          "git"
        ],
        "operations": [
          "add"
        ]
      }
    },
    {
      "id": "git.commit",
      "description": "A commit records authorship and requires a human decision.",
      "disposition": "REQUIRE_APPROVAL",
      "match": {
        "action_kinds": [
          "git"
        ],
        "operations": [
          "commit"
        ]
      }
    },
    {
      "id": "git.push",
      "description": "Publishing to a remote requires a human decision.",
      "disposition": "REQUIRE_APPROVAL",
      "match": {
        "action_kinds": [
          "git"
        ],
        "operations": [
          "push"
        ]
      }
    },
    {
      "id": "git.force-push",
      "description": "Force pushing rewrites published history and is refused.",
      "disposition": "DENY",
      "match": {
        "action_kinds": [
          "git"
        ],
        "operations": [
          "force_push"
        ]
      }
    },
    {
      "id": "git.remote-mutation",
      "description": "Changing where code is published requires a human decision.",
      "disposition": "REQUIRE_APPROVAL",
      "match": {
        "action_kinds": [
          "git"
        ],
        "operations": [
          "remote_add",
          "remote_set_url",
          "remote_remove"
        ]
      }
    },
    {
      "id": "git.destructive",
      "description": "Discarding work with reset --hard, clean, or branch deletion requires a human decision.",
      "disposition": "REQUIRE_APPROVAL",
      "match": {
        "action_kinds": [
          "git"
        ],
        "operations": [
          "reset_hard",
          "clean",
          "branch_delete",
          "tag_delete"
        ]
      }
    },
    {
      "id": "shell.destructive",
      "description": "Destructive or privilege-escalating shell commands are refused.",
      "disposition": "DENY",
      "match": {
        "action_kinds": [
          "shell"
        ],
        "destructive": true
      }
    },
    {
      "id": "shell.package-install",
      "description": "Installing packages pulls in third-party code; allowed but flagged.",
      "disposition": "ALLOW_WITH_WARNING",
      "match": {
        "action_kinds": [
          "shell"
        ],
        "argument_pattern": "\\b(npm|yarn|pnpm|pip|pip3|gem|cargo|go|apt|apt-get|brew)\\b[^\"]*\\b(install|add|get)\\b"
      }
    },
    {
      "id": "shell.deploy",
      "description": "Deployment and publication commands require a human decision.",
      "disposition": "REQUIRE_APPROVAL",
      "match": {
        "action_kinds": [
          "shell"
        ],
        "argument_pattern": "\\b(kubectl|helm|terraform|serverless|vercel|netlify|fly|heroku)\\b|\\bnpm\\s+publish\\b|\\bdocker\\s+push\\b"
      }
    },
    {
      "id": "http.public-read",
      "description": "Public reads are allowed and recorded.",
      "disposition": "ALLOW_WITH_WARNING",
      "match": {
        "action_kinds": [
          "http"
        ],
        "operations": [
          "read"
        ]
      }
    },
    {
      "id": "http.mutation",
      "description": "External mutations require a human decision.",
      "disposition": "REQUIRE_APPROVAL",
      "match": {
        "action_kinds": [
          "http"
        ],
        "operations": [
          "write",
          "authenticated_mutation"
        ]
      }
    },
    {
      "id": "http.external-communication",
      "description": "Sending a message outside the runtime requires a human decision.",
      "disposition": "REQUIRE_APPROVAL",
      "match": {
        "action_kinds": [
          "http"
        ],
        "operations": [
          "external_communication"
        ]
      }
    },
    {
      "id": "http.credential-export",
      "description": "Transmitting credentials off the host is refused.",
      "disposition": "DENY",
      "match": {
        "action_kinds": [
          "http"
        ],
        "argument_pattern": "(BEGIN [A-Z ]*PRIVATE KEY|aws_secret_access_key|api[_-]?key\"\\s*:|password\"\\s*:|ssh-rsa AAAA)"
      }
    },
    {
      "id": "mcp.call",
      "description": "Downstream MCP calls are governed and recorded.",
      "disposition": "ALLOW_WITH_WARNING",
      "match": {
        "action_kinds": [
          "mcp"
        ]
      }
    },
    {
      "id": "mcp.consequential",
      "description": "Downstream MCP tools that write, send, deploy, or delete require a human decision.",
      "disposition": "REQUIRE_APPROVAL",
      "match": {
        "action_kinds": [
          "mcp"
        ],
        "argument_pattern": "\"(write|send|delete|deploy|publish|create|update|remove|execute)"
      }
    },
    {
      "id": "governance.bypass",
      "description": "Any attempt to disable, bypass, or ignore SafeLoop governance is refused.",
      "disposition": "DENY",
      "match": {
        "argument_pattern": "(ignore|bypass|disable|skip|turn off|circumvent)\\s+(the\\s+)?(safeloop|approval|guardrail|governance|polic)",
        "ignore_case": true
      }
    },
    {
      "id": "delegation.subagent",
      "description": "Delegation is allowed; the runtime enforces ceiling inheritance separately.",
      "disposition": "ALLOW_WITH_WARNING",
      "match": {
        "action_kinds": [
          "delegation"
        ]
      }
    }
  ],
  "managed_paths": [
    {
      "path": "shell",
      "state": "MANAGED",
      "consequential": true,
      "certification_impact": true,
      "mechanism": "SafeLoop managed shell executor (permit-bound argv execution)"
    },
    {
      "path": "filesystem",
      "state": "MANAGED",
      "consequential": true,
      "certification_impact": true,
      "mechanism": "SafeLoop managed filesystem executor"
    },
    {
      "path": "git",
      "state": "MANAGED",
      "consequential": true,
      "certification_impact": true,
      "mechanism": "SafeLoop managed git executor (structured operation family)"
    },
    {
      "path": "http",
      "state": "MANAGED",
      "consequential": true,
      "certification_impact": true,
      "mechanism": "SafeLoop managed HTTP executor"
    },
    {
      "path": "mcp",
      "state": "MANAGED",
      "consequential": true,
      "certification_impact": true,
      "mechanism": "SafeLoop MCP governance gateway"
    },
    {
      "path": "memory",
      "state": "MANAGED",
      "consequential": true,
      "certification_impact": true,
      "mechanism": "SafeLoop memory gateway with persistence permits"
    },
    {
      "path": "delegation",
      "state": "MANAGED",
      "consequential": true,
      "certification_impact": true,
      "mechanism": "SafeLoop delegation inheritance with privilege-widening rejection"
    },
    {
      "path": "browser",
      "state": "DISABLED",
      "consequential": true,
      "certification_impact": false,
      "notes": "Not enabled in the certified coding profile."
    },
    {
      "path": "computer_use",
      "state": "DISABLED",
      "consequential": true,
      "certification_impact": false,
      "notes": "Not enabled in the certified coding profile."
    },
    {
      "path": "cron",
      "state": "DISABLED",
      "consequential": true,
      "certification_impact": false,
      "notes": "Scheduled execution is not enabled in the certified coding profile."
    }
  ],
  "launch_environment": {
    "set": {
      "HERMES_DISABLE_LAZY_INSTALLS": "1",
      "PIP_NO_INPUT": "1"
    },
    "unset": [
      "HERMES_LAZY_INSTALL_TARGET"
    ],
    "rationale": "Disables runtime dependency installation in the launched agent. Package installation is a consequential network and code-execution path that SafeLoop does not manage, so a governed session must not be able to reach it. Variables an agent does not recognise are inert."
  }
}
