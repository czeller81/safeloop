{
  "name": "safeloop",
  "version": "0.2.0",
  "description": "SafeLoop is a local runtime governance layer for autonomous AI agents. It evaluates and controls agent actions, approvals, memory, budgets, evidence, and configured managed execution paths routed through the SafeLoop runtime.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "safeloop": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/czeller81/safeloop"
  },
  "bugs": {
    "url": "https://github.com/czeller81/safeloop/issues"
  },
  "homepage": "https://github.com/czeller81/safeloop#readme",
  "files": [
    "dist",
    "docs",
    "schemas",
    "python",
    "protocol",
    "profiles"
  ],
  "scripts": {
    "build:ui": "vite build --config vite.config.mts",
    "build": "npm run build:ui && tsc",
    "test": "jest --config jest.config.js",
    "test:python": "python -m pytest python/tests",
    "verify": "npm run build && npm test -- --runInBand && npm audit --audit-level=moderate",
    "monitor": "npm run build:ui && ts-node src/cli.ts monitor",
    "mcp:doctor": "ts-node src/cli.ts mcp doctor",
    "mcp:doctor:hermes": "ts-node src/cli.ts mcp doctor --host hermes",
    "monitor:dogfood": "npm run monitor -- --baseDir .safeloop-dogfood",
    "dogfood:handoff": "ts-node examples/case-handoff-monitor-dogfood.ts",
    "safeloop": "ts-node src/cli.ts",
    "example": "ts-node examples/wrap-agent.ts",
    "example:live-simulation": "ts-node examples/breaker-live-simulation.ts",
    "demo:codex-governed": "ts-node examples/codex-governed-workflow-demo.ts",
    "demo:k12-local-rag": "ts-node examples/k12-local-rag-demo.ts",
    "prepare": "npm run build",
    "test:runtime": "jest --config jest.config.js tests/runtime.*.test.ts",
    "certify": "ts-node src/cli.ts certify",
    "daemon": "ts-node src/cli.ts daemon"
  },
  "keywords": [
    "ai",
    "agents",
    "governance",
    "accountability",
    "handoff",
    "workflow",
    "audit",
    "safety",
    "local-first",
    "mcp",
    "command-guard",
    "policy-gate",
    "agent-governance",
    "ai-observability",
    "typescript",
    "monitor",
    "cost",
    "steering",
    "drift"
  ],
  "author": "Charles Zeller <charleszeller@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@rollup/wasm-node": "^4.62.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^8.2.1"
  }
}
