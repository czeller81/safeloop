{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safeloop.dev/schemas/memory-candidate.schema.json",
  "title": "SafeLoop Memory Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["memory_id", "memory_type", "situation", "lesson"],
  "properties": {
    "memory_id": { "type": "string", "minLength": 1 },
    "memory_type": { "type": "string", "minLength": 1 },
    "source_task": { "type": "string" },
    "agent": { "type": "string" },
    "situation": { "type": "string", "minLength": 1 },
    "action": { "type": "string" },
    "outcome": { "type": "string" },
    "lesson": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "reuse_conditions": { "type": "array", "items": { "type": "string" } },
    "do_not_generalize": { "type": "boolean" },
    "tenant": { "type": "string" },
    "ttl": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "containsSensitiveData": { "type": "boolean" }
  }
}
