{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safeloop.dev/schemas/governance-event.schema.json",
  "title": "SafeLoop Governance Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "type", "timestamp", "agent_id"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "task_id": { "type": "string" },
    "session_id": { "type": "string" },
    "agent_id": { "type": "string", "minLength": 1 },
    "agent_name": { "type": "string" },
    "agent_type": { "type": "string" },
    "model": { "type": "string" },
    "provider": { "type": "string" },
    "user_id": { "type": "string" },
    "tenant_id": { "type": "string" },
    "tool": { "type": "string" },
    "action": { "type": "string" },
    "target": { "type": "string" },
    "arguments_hash": { "type": "string" },
    "policy_ids": { "type": "array", "items": { "type": "string" } },
    "risk_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "risk_dimensions": {
      "type": "array",
      "items": { "$ref": "risk-dimension.schema.json" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "decision": { "$ref": "policy-decision.schema.json#/$defs/disposition" },
    "decision_reason": { "type": "string" },
    "approval_id": { "type": "string" },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "artifact_ids": { "type": "array", "items": { "type": "string" } },
    "cost": { "type": "number", "minimum": 0 },
    "token_usage": { "$ref": "token-usage.schema.json" },
    "latency": { "type": "number", "minimum": 0 },
    "parent_event_id": { "type": "string" },
    "trace_id": { "type": "string" },
    "provenance": { "$ref": "provenance.schema.json" },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}
