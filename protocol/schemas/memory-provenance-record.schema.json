{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safeloop.dev/protocol/safeloop.runtime.v1/memory-provenance-record.schema.json",
  "title": "MemoryProvenanceRecord",
  "description": "Answers \"why does this agent remember this?\"",
  "protocolVersion": "safeloop.runtime.v1",
  "type": "object",
  "required": [
    "protocol_version",
    "memory_id",
    "candidate_fingerprint",
    "originating_agent",
    "originating_task",
    "tenant_id",
    "evidence_ids",
    "artifact_ids",
    "confidence",
    "decision",
    "created_at",
    "supersedes",
    "contradicts",
    "reuse_conditions",
    "do_not_generalize",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "safeloop.runtime.v1"
    },
    "memory_id": {
      "type": "string"
    },
    "candidate_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "originating_agent": {
      "type": "string"
    },
    "originating_task": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "ALLOW_WITH_TTL",
        "MERGE",
        "QUARANTINE",
        "REQUIRE_REVIEW",
        "REJECT"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reuse_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "do_not_generalize": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "QUARANTINED",
        "REVIEW_REQUIRED",
        "REJECTED",
        "EXPIRED",
        "SUPERSEDED"
      ]
    }
  }
}
