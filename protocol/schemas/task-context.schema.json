{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safeloop.dev/protocol/safeloop.runtime.v1/task-context.schema.json",
  "title": "TaskContext",
  "description": "A unit of governed work inside a session.",
  "protocolVersion": "safeloop.runtime.v1",
  "type": "object",
  "required": [
    "task_id",
    "session_id",
    "tenant_id",
    "started_at"
  ],
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string"
    }
  }
}
