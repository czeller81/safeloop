{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safeloop.dev/protocol/safeloop.runtime.v1/artifact-record.schema.json",
  "title": "ArtifactRecord",
  "description": "A file or object a governed action produced or changed.",
  "protocolVersion": "safeloop.runtime.v1",
  "type": "object",
  "required": [
    "protocol_version",
    "artifact_id",
    "path",
    "content_hash",
    "operation",
    "agent_id",
    "task_id",
    "tenant_id",
    "recorded_at"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "safeloop.runtime.v1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string"
    },
    "content_hash": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
