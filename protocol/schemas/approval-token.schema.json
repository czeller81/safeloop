{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safeloop.dev/protocol/safeloop.runtime.v1/approval-token.schema.json",
  "title": "BoundApprovalToken",
  "description": "Integrity-protected, action-bound, single-use approval. HMAC-SHA256 over the claim set.",
  "protocolVersion": "safeloop.runtime.v1",
  "type": "object",
  "required": [
    "protocol_version",
    "approval_id",
    "action_fingerprint",
    "agent_id",
    "task_id",
    "session_id",
    "scenario_id",
    "tenant_id",
    "issued_at",
    "expires_at",
    "nonce",
    "policy_version",
    "approver",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "safeloop.runtime.v1"
    },
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "action_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "agent_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "minLength": 16
    },
    "policy_version": {
      "type": "string"
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
